# ─────────────────────────────────────────────────────────────────────────────
# Credit Card Fraud Detection API — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Credit Card Fraud Detection API"
APP_VERSION=1.0.0
DEBUG=false
WORKERS=4
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_KEY=changeme-secret-api-key

# ── Model ─────────────────────────────────────────────────────────────────────
MODEL_PATH=models/fraud_pipeline.joblib
MODEL_LOAD_FROM_REGISTRY=false
MLFLOW_MODEL_NAME=fraud-detection
MLFLOW_MODEL_STAGE=Production
FRAUD_THRESHOLD=0.5

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=credit-card-fraud-detection

# ── PostgreSQL (MLflow backend) ───────────────────────────────────────────────
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow123
POSTGRES_DB=mlflow_db

# ── MinIO (S3 artifact store) ─────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=mlflow-artifacts

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["*"]
ALLOWED_HOSTS=["*"]
